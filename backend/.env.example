# ── 文生图（必填，验收前提供）──
MODEL_T2I_BASE_URL=https://api.siliconflow.cn/v1
MODEL_T2I_API_KEY=
MODEL_T2I_NAME=black-forest-labs/FLUX.1-schnell
# 单价（元/张），用于成本显示与预算守卫。以供应商实际账单为准。
MODEL_T2I_UNIT_PRICE=0.03

# ── prompt 扩写（可选，留空则用内置模板）──
MODEL_LLM_BASE_URL=https://api.deepseek.com/v1
MODEL_LLM_API_KEY=
MODEL_LLM_NAME=deepseek-chat

# ── 预算守卫（单任务金额上限，元）──
TASK_BUDGET_CNY=5.00

# ── 存储 ──
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/app.db
