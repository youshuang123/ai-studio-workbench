# ── 文生图（必填，验收前提供）──
MODEL_T2I_BASE_URL=https://api.siliconflow.cn/v1
MODEL_T2I_API_KEY=
MODEL_T2I_NAME=Tongyi-MAI/Z-Image-Turbo
# 单价（元/张），用于成本显示与预算守卫。以供应商实际账单为准。
MODEL_T2I_UNIT_PRICE=0.03

# ── prompt 扩写（可选，留空则用内置模板）──
# 留空则复用 MODEL_T2I_BASE_URL（硅基流动）
MODEL_LLM_BASE_URL=
MODEL_LLM_API_KEY=
MODEL_LLM_NAME=deepseek-ai/DeepSeek-V4-Flash

# ── 预算守卫（单任务金额上限，元）──
TASK_BUDGET_CNY=5.00

# ── 精修（2-3，图生图；留空则复用上面的 Key）──
MODEL_EDIT_BASE_URL=https://api.siliconflow.cn/v1
MODEL_EDIT_API_KEY=
MODEL_EDIT_NAME=Qwen/Qwen-Image-Edit-2509
MODEL_EDIT_UNIT_PRICE=0.30

# ── 质检（2-3，VLM；留空则复用上面的 Key）──
MODEL_VLM_BASE_URL=https://api.siliconflow.cn/v1
MODEL_VLM_API_KEY=
MODEL_VLM_NAME=Qwen/Qwen3-VL-8B-Instruct
MODEL_VLM_UNIT_PRICE=0.003

DELTA_E_THRESHOLD=3.0
BATCH_REFINE_LIMIT=20
BATCH_REFINE_BUDGET_CNY=5.00

# ── 批量（2-2）──
BATCH_CONCURRENCY=3
BATCH_BUDGET_CNY=10.00
BATCH_MAX_ROWS=200

# ── 存储 ──
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/app.db
